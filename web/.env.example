# Copia a .env.local para desarrollo local, o pega estos nombres en el panel de
# Vercel. Ninguno es secreto: todo lo que lleve el prefijo NEXT_PUBLIC_ se
# empaqueta en el JavaScript que llega al navegador.

# Direcciones de los contratos desplegados.
#
# En local NO las escribas a mano: `npm run dev` y `npm run build` ejecutan
# scripts/sync-deployment.mjs, que las copia desde deployment.json en la raiz
# del repo. Ese fichero esta en .gitignore, asi que en Vercel si hay que
# ponerlas aqui a mano.
NEXT_PUBLIC_ENROLLMENT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_HEARTBEAT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_LOTTERY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TICKET_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CLUSTER_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# RPC dedicado. Opcional, pero muy recomendable: el publico esta limitado a
# 15-25 peticiones por segundo COMPARTIDAS con todo el mundo, y unas pocas
# decenas de usuarios lo agotan. El sintoma es transacciones y lecturas
# rechazadas de forma aparentemente aleatoria, que parece un fallo propio.
#
# Va en el bundle del navegador, asi que NO es secreto: restringelo por dominio
# en el panel del proveedor y no cuentes con que quede oculto.
#
# NEXT_PUBLIC_MONAD_RPC_URL=https://monad-testnet.g.alchemy.com/v2/TU_CLAVE
